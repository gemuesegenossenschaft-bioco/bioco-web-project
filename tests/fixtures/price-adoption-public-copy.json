{
    "table_html": "<div class=\"pricing-table\"><table><thead><tr><th scope=\"col\">Gemüsekorb<\/th><th scope=\"col\">Personen<\/th><th scope=\"col\">Jahrespreis<\/th><th scope=\"col\">Anteilsscheine Kosten<\/th><th scope=\"col\">Mitarbeit pro Jahr<\/th><\/tr><\/thead><tbody><tr><td><strong>Halb<\/strong><div class=\"cms-pricing-table-shares\">1 Anteilsschein<\/div><\/td><td><div class=\"person-icons\" role=\"img\" aria-label=\"1 Person\"><div class=\"person-icons-row\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"person-icon\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"8\" r=\"4\" fill=\"var(--wp--preset--color--bioco-green)\" stroke=\"var(--wp--preset--color--bioco-green-dark)\" stroke-width=\"1\"\/><path d=\"M6 20C6 16 8 14 12 14C16 14 18 16 18 20\" stroke=\"var(--wp--preset--color--bioco-green)\" stroke-width=\"2\" stroke-linecap=\"round\" fill=\"none\"\/><\/svg><\/div><\/div><\/td><td>CHF 750.-<\/td><td>CHF 250.-<\/td><td>10 Arbeitseinsätze<br \/><span class=\"cms-pricing-table-work-suffix\">à 2 Stunden<\/span><\/td><\/tr><tr><td><strong>Standard<\/strong><div class=\"cms-pricing-table-shares\">2 Anteilsscheine<\/div><\/td><td><div class=\"person-icons\" role=\"img\" aria-label=\"2 Personen\"><div class=\"person-icons-row\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"person-icon\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"8\" r=\"4\" fill=\"var(--wp--preset--color--bioco-green)\" stroke=\"var(--wp--preset--color--bioco-green-dark)\" stroke-width=\"1\"\/><path d=\"M6 20C6 16 8 14 12 14C16 14 18 16 18 20\" stroke=\"var(--wp--preset--color--bioco-green)\" stroke-width=\"2\" stroke-linecap=\"round\" fill=\"none\"\/><\/svg><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"person-icon\" aria-hidden=\"true\" focusable