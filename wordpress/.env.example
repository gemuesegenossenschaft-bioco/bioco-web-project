# Bedrock env — real .env is server/CI only, never committed
DB_NAME='bioco_wp'
DB_USER=''
DB_PASSWORD=''
DB_HOST='localhost'
# Generate: https://roots.io/salts.html
AUTH_KEY='replace-with-generated-auth-key'
SECURE_AUTH_KEY='replace-with-generated-secure-auth-key'
LOGGED_IN_KEY='replace-with-generated-logged-in-key'
NONCE_KEY='replace-with-generated-nonce-key'
AUTH_SALT='replace-with-generated-auth-salt'
SECURE_AUTH_SALT='replace-with-generated-secure-auth-salt'
LOGGED_IN_SALT='replace-with-generated-logged-in-salt'
NONCE_SALT='replace-with-generated-nonce-salt'
WP_ENV='staging'
WP_HOME='https://staging.bioco.ch'
WP_SITEURL="${WP_HOME}/wp"
# SMTP (reuse Novatrend) — set on server only
SMTP_HOST='mail.bioco.ch'
SMTP_PORT='465'
SMTP_USER=''
SMTP_PASS=''
SMTP_SECURE='ssl'
# Cloudflare Turnstile (reuse existing keys) — secret server only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=''
TURNSTILE_SECRET_KEY=''
# Intranet signup forward target
INTRANET_SIGNUP_URL='https://intranet.bioco.ch/my/signup/'
