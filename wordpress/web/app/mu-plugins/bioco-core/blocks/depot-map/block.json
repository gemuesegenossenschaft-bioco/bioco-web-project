{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "bioco/depot-map",
  "title": "Depot-Karte",
  "description": "Karte + Adressliste der Gemüse-Depots (Dienstag/Freitag-Abholung).",
  "category": "bioco",
  "icon": "location-alt",
  "keywords": ["depot", "karte", "abholung", "map"],
  "textdomain": "bioco",
  "acf": {
    "mode": "auto",
    "renderTemplate": "render.php"
  },
  "viewScript": "bioco-depot-map-view-script",
  "viewStyle": "bioco-leaflet",
  "supports": {
    "anchor": true,
    "align": false,
    "mode": false,
    "jsx": false,
    "customClassName": true
  }
}
